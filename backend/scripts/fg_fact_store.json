{
  "_documentation": {
    "model_purpose": "CNN Fear & Greed Index state probability lookup matrix for market timing and position sizing gating",
    "return_formula": "R_h = (SPY_{t+h} - SPY_t) / SPY_t",
    "state_hierarchy": {
      "L0": "FG_Granular_Band",
      "L1": "FG_Velocity_Vector",
      "L2": "SPY_ZigZag_Leg"
    },
    "dimension_thresholds_definition": {
      "DEEP_FEAR": "FG < 10 (Systemic capitulation)",
      "EXTREME_FEAR": "10 <= FG < 25 (Extreme panic)",
      "FEAR": "25 <= FG < 45 (Mild pessimism)",
      "NEUTRAL": "45 <= FG <= 55 (Balanced)",
      "GREED": "55 < FG <= 75 (Bullish momentum)",
      "EXTREME_GREED": "75 < FG <= 85 (High optimism)",
      "EUPHORIA": "FG > 85 (Structural trend continuation / Overboss)",
      "FALLING_FAST": "delta_3d <= -5.0 (Accelerating panic)",
      "STABLE": "-5.0 < delta_3d < 5.0 (Consolidation)",
      "RISING_FAST": "delta_3d >= 5.0 (Accelerating buying)",
      "ZIG_BULL": "SPY in 5.0% ZigZag up leg",
      "ZAG_BEAR": "SPY in 5.0% ZigZag down leg"
    },
    "field_glossary": {
      "n": "Sample size in historical dataset",
      "fg_t0_stats": "Statistics of FG index on current day t0",
      "fg_t_minus_1_stats": "Statistics of FG index on previous day t-1",
      "p_bull_5d": "Probability of positive return over 5 trading days",
      "ev_5d_pct": "Expected Value in % over 5 trading days",
      "p_bull_20d": "Probability of positive return over 20 trading days",
      "ev_20d_pct": "Expected Value in % over 20 trading days",
      "rr_asymmetry": "Ratio of average positive return to average negative return",
      "tstat_20d_adj": "L\u00f3pez de Prado adjusted t-statistic for overlapping returns (N_eff = N/20)"
    },
    "signal_interpretation_policy": "Pure domain adapters (MarketHealthIntelligence, QualityEntryGate) interpret probabilities dynamically. Signals are not static strings in JSON."
  },
